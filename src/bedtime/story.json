{
  "title": "परी और जुगनू",
  "subtitle": "नींद वाली सैर",
  "beats": [
    {
      "id": "title",
      "seconds": 6.61,
      "lines": [
        {
          "who": "n",
          "text": "आज की कहानी है… परी और जुगनू की, नींद वाली सैर।",
          "start": 0.3,
          "end": 5.31
        }
      ]
    },
    {
      "id": "awake",
      "seconds": 15.44,
      "lines": [
        {
          "who": "n",
          "text": "एक छोटे से गाँव में, एक छोटी सी बच्ची रहती थी, परी।",
          "start": 0.3,
          "end": 5.46
        },
        {
          "who": "n",
          "text": "रात हो गई थी, सब सो गए थे… पर परी की आँखें खुली थीं।",
          "start": 6.01,
          "end": 11.71
        },
        {
          "who": "p",
          "text": "मुझे तो नींद ही नहीं आ रही।",
          "start": 12.26,
          "end": 14.14
        }
      ]
    },
    {
      "id": "jugnu",
      "seconds": 11.42,
      "lines": [
        {
          "who": "n",
          "text": "तभी खिड़की पर, एक नन्ही सी रोशनी टिमटिमाई।",
          "start": 0.3,
          "end": 4.35
        },
        {
          "who": "j",
          "text": "नमस्ते परी! मैं हूँ जुगनू। चलो, सबको शुभ रात्रि कहने चलें!",
          "start": 4.9,
          "end": 10.12
        }
      ]
    },
    {
      "id": "birds",
      "seconds": 13.3,
      "lines": [
        {
          "who": "n",
          "text": "सबसे पहले वो पहुँचे, नीम के पेड़ पर।",
          "start": 0.3,
          "end": 3.78
        },
        {
          "who": "n",
          "text": "घोंसले में चिड़िया के बच्चे, माँ के पंखों में दुबक कर सो रहे थे।",
          "start": 4.33,
          "end": 9.44
        },
        {
          "who": "p",
          "text": "शुभ रात्रि, नन्ही चिड़िया।",
          "start": 9.99,
          "end": 12.0
        }
      ]
    },
    {
      "id": "pond",
      "seconds": 11.8,
      "lines": [
        {
          "who": "n",
          "text": "फिर वो पहुँचे तालाब के पास।",
          "start": 0.3,
          "end": 2.47
        },
        {
          "who": "n",
          "text": "कमल के पत्ते पर बैठा मेंढक, बड़ी सी जम्हाई ले रहा था।",
          "start": 3.02,
          "end": 7.87
        },
        {
          "who": "p",
          "text": "शुभ रात्रि, मेंढक भैया।",
          "start": 8.42,
          "end": 10.5
        }
      ]
    },
    {
      "id": "clouds",
      "seconds": 12.96,
      "lines": [
        {
          "who": "n",
          "text": "जुगनू परी को ऊपर ले गया, बादलों तक।",
          "start": 0.3,
          "end": 3.53
        },
        {
          "who": "n",
          "text": "बादल रुई के तकियों जैसे नरम थे, और धीरे-धीरे तैर रहे थे।",
          "start": 4.08,
          "end": 9.38
        },
        {
          "who": "p",
          "text": "शुभ रात्रि, बादल।",
          "start": 9.93,
          "end": 11.66
        }
      ]
    },
    {
      "id": "moon",
      "seconds": 13.13,
      "lines": [
        {
          "who": "n",
          "text": "और सबसे ऊपर, चाँद मामा मुस्कुरा रहे थे।",
          "start": 0.3,
          "end": 3.98
        },
        {
          "who": "c",
          "text": "परी बिटिया, अब सोने का समय है। मैं रात भर, तुम्हारी खिड़की पर रोशनी रखूँगा।",
          "start": 4.53,
          "end": 11.83
        }
      ]
    },
    {
      "id": "home",
      "seconds": 12.15,
      "lines": [
        {
          "who": "n",
          "text": "जुगनू परी को वापस घर ले आया। परी ने रज़ाई ओढ़ी, और आँखें मूँद लीं।",
          "start": 0.3,
          "end": 6.84
        },
        {
          "who": "p",
          "text": "शुभ रात्रि, जुगनू।",
          "start": 7.39,
          "end": 9.14
        },
        {
          "who": "j",
          "text": "शुभ रात्रि, परी।",
          "start": 9.69,
          "end": 10.85
        }
      ]
    },
    {
      "id": "sleep",
      "seconds": 11.66,
      "lines": [
        {
          "who": "n",
          "text": "बाहर चाँद चमकता रहा, तारे टिमटिमाते रहे… और परी, मीठे सपनों में खो गई।",
          "start": 0.3,
          "end": 7.91
        },
        {
          "who": "n",
          "text": "शुभ रात्रि, बच्चो।",
          "start": 8.46,
          "end": 10.36
        }
      ]
    }
  ]
}
